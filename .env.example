# Copia este archivo como .env y ajusta los valores.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# DJANGO_CSRF_TRUSTED_ORIGINS=https://taller.midominio.com
# DJANGO_ADMIN_URL=panel-interno-9f3k/

# --- Base de datos ---------------------------------------------------------
# sqlite (por defecto, ideal para desarrollo) o mysql (MariaDB)
DB_ENGINE=sqlite
# DB_ENGINE=mysql
# DB_NAME=motortech
# DB_USER=motortech
# DB_PASSWORD=contraseña-segura
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Sesión ---------------------------------------------------------------
SESSION_REMEMBER_SECONDS=1209600
# LOGIN_MAX_INTENTOS=5
# LOGIN_BLOQUEO_SEGUNDOS=900

# --- Producción (DJANGO_DEBUG=False) ---------------------------------------
# DJANGO_SSL_REDIRECT=True
# DJANGO_COOKIES_SEGURAS=True
